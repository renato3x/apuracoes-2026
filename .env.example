# simulation usa o ambiente público de simulados DO TSE, sem votos inventados.
# production aceita somente arquivos com fase oficial (f=o).
TSE_DATA_MODE=simulation
# Consultas em milissegundos. Mínimo 10s; não representa a cadência de publicação do TSE.
RESULTS_REFRESH_INTERVAL=30000
# Opcional: cache distribuído, controle de concorrência e snapshots persistentes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SNAPSHOTS_ENABLED=false
# URL canônica usada no sitemap e OpenGraph
SITE_URL=http://localhost:3000
